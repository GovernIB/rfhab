<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>rfhab</artifactId>
        <groupId>es.caib.rfhab</groupId>
        <version>1.0.3</version>
    </parent>
    <artifactId>rfhab-api-interna</artifactId>
    <packaging>war</packaging>
    <name>RFHab - API Rest - Interna Server</name>
    <properties>
        <auth.method>BASIC</auth.method>
        <client.default.package>es.caib.rfhab.api.interna.client</client.default.package>
    </properties>

    <dependencies>
        <!-- Altres mòduls del projecte -->
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-commons</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-persistence</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-model</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-ejb</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-rolsac-model</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        
		<!-- Externas -->
		
        <dependency>
			<groupId>org.fundaciobit.genapp</groupId>
			<artifactId>genapp-core</artifactId>
			<version>${genapp.version}</version>
			<scope>provided</scope>
		</dependency>

        <!-- Anotacions de documentació de openapi -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <artifactId>pluginsib-utils-rest</artifactId>
            <groupId>org.fundaciobit.pluginsib.utils</groupId>
            <version>${pluginsib.utils.rest.version}</version>
        </dependency>

        <dependency>
            <groupId>org.fundaciobit.pluginsib.utils</groupId>
            <artifactId>pluginsib-utils-swagger-ui-configurable-webjar</artifactId>
            <version>${pluginsib.utils.version}</version>
        </dependency>

        <dependency>
            <groupId>javax</groupId>
            <artifactId>javaee-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-resources</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/classes</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/../rfhab-ejb/src/main/resources</directory>
									<includes>
										<include>logicmissatges_*.properties</include>
										<include>genapp_*.properties</include>
										<include>rfhab_genapp_*.properties</include>
									</includes>
									<filtering>true</filtering>
								</resource>
							</resources>
							<overwrite>true</overwrite>
						</configuration>
					</execution>
				</executions>
			</plugin>

            <!-- comprovació d'apòstrof dins els fitxers properties -->
            <!-- El problema és que la tasca Ant <resourcecontains> cerca fitxers en el directori de treball actual, però per defecte només cerca dins l’arxiu JAR/target, no a src/main/resources ni als fitxers copiats per Maven. Això fa que no trobi el fitxer nom_fitxer.properties amb l’apòstrof -->
            <!-- Durant la fase validate, Maven encara no ha copiat els fitxers de src/main/resources a target/classes. Per això la tasca Ant <resourcecontains> només pot trobar fitxers que ja existeixen al sistema de fitxers en aquell moment (normalment a src/main/resources, no a target/classes) -->
