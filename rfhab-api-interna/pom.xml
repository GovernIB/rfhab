                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="S'ha trobat un apòstrof (') en algun fitxer .properties!">
                                    <condition>
                                        <resourcecontains resource="**/*.properties" substring="'"/>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin> -->
            
            <!-- Genera el descriptor openapi.json de forma estàtica, després 
                el posarem l'arrel del WAR -->
            <!-- https://github.com/swagger-api/swagger-core/tree/master/modules/swagger-maven-plugin -->
            <plugin>

                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-maven-plugin</artifactId>
                <version>2.2.15</version>
                
                <configuration>
                    <outputFormat>JSON</outputFormat>
                    <prettyPrint>TRUE</prettyPrint>
                    <outputPath>${project.basedir}/openapi/</outputPath>                   
                </configuration>

                <executions>
                    <execution>
                        <id>openapi_interna_1</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>RFHab API Interna Public</contextId>
                            <outputFileName>rfhab_api_interna_public</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.all.general</package>
                                <package>es.caib.rfhab.api.interna.all.habilitacio</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi_interna_2</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>RFHab API Interna Seguretat</contextId>
                            <outputFileName>rfhab_api_interna_secure</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.secure.activitat</package>
                                <package>es.caib.rfhab.api.interna.secure.funcionari</package>
                                <package>es.caib.rfhab.api.interna.secure.lloc</package>
                                <package>es.caib.rfhab.api.interna.secure.funcionarilloc</package>
                                <package>es.caib.rfhab.api.interna.secure.carregadades</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi_interna_3</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>RFHab API Interna Dades Obertes</contextId>
                            <outputFileName>rfhab_api_interna_dadesobertes</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.all.exemplereutilitzacio</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


