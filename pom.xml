            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.0.0</version>
                        <executions>
                            <execution>
                                <id>check-apostrophe-unix</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target xmlns:unless="ant:unless" xmlns:if="ant:if">
                                        <property name="rfhab.root" value="rfhab-1.0"/>
                                        <condition property="is.rfhab.root">
                                            <contains string="${project.basedir}" substring="${rfhab.root}"/>
                                        </condition>
                                        <echo level="warning" unless:set="is.rfhab.root">========================================</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">AVÍS: Saltant comprovació d'apòstrof</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">Només s'executa dins rfhab-1.0</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">========================================</echo>
                                        <fileset if:set="is.rfhab.root" id="properties.files" dir="${project.basedir}">
                                            <include name="**/src/main/resources/*.properties"/>
                                            <exclude name="**/src/main/resources/ValidationMessages.properties"/>
                                            <exclude name="**/src/main/resources/ValidationMessages_es.properties"/>
                                        </fileset>
                                        <apply if:set="is.rfhab.root" executable="${project.basedir}/scripts/mvnvalidations/check_apostrophe.sh" failonerror="true">
                                            <fileset refid="properties.files"/>
                                            <srcfile/>
                                        </apply>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
