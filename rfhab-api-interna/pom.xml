    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>rfhab</artifactId>
        <groupId>es.caib.rfhab</groupId>
        <version>1.0.0</version>
    </parent>
    <artifactId>rfhab-api-interna</artifactId>
    <packaging>war</packaging>
    <name>RFHab - API Rest - Interna Server</name>
    <properties>
        <auth.method>BASIC</auth.method>
        <client.default.package>es.caib.rfhab.api.interna.client</client.default.package>
    </properties>

    <dependencies>
        <!-- Altres mòduls del projecte -->
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-commons</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-persistence</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-model</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab</groupId>
            <artifactId>rfhab-ejb</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>es.caib.rfhab.pluginsib</groupId>
            <artifactId>rfhab-pluginsib-rolsac</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <dependency>
			<groupId>es.caib.rfhab</groupId>
			<artifactId>rfhab-pluginsib-rolsac-client</artifactId>
			<version>1.0-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>com.google.errorprone</groupId>
                    <artifactId>error_prone_annotations</artifactId>
                </exclusion>
			</exclusions>
		</dependency>

        <!-- Anotacions de documentació de openapi -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <artifactId>pluginsib-utils-rest</artifactId>
            <groupId>org.fundaciobit.pluginsib.utils</groupId>
            <version>${pluginsib.utils.rest.version}</version>
        </dependency>

        <dependency>
            <groupId>org.fundaciobit.pluginsib.utils</groupId>
            <artifactId>pluginsib-utils-swagger-ui-configurable-webjar</artifactId>
            <version>${pluginsib.utils.version}</version>
        </dependency>

        <dependency>
            <groupId>javax</groupId>
            <artifactId>javaee-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Genera el descriptor openapi.json de forma estàtica, després 
                el posarem l'arrel del WAR -->
            <!-- https://github.com/swagger-api/swagger-core/tree/master/modules/swagger-maven-plugin -->
            <plugin>

                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-maven-plugin</artifactId>
                <version>2.2.15</version>
                
                <configuration>
                    <outputFormat>JSON</outputFormat>
                    <prettyPrint>TRUE</prettyPrint>
                    <outputPath>${project.basedir}/openapi/</outputPath>                   
                </configuration>

                <executions>
                    <execution>
                        <id>openapi_interna_1</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>Exemple Interna Public</contextId>
                            <outputFileName>openapi_interna_public</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.all.exemplepublic</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi_interna_2</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>Exemple Interna Seguretat</contextId>
                            <outputFileName>openapi_interna_secure</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.secure.activitat</package>
                                <package>es.caib.rfhab.api.interna.secure.funcionari</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi_interna_3</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>resolve</goal>
                        </goals>
                        <configuration>
                            <contextId>Exemple Interna Dades Obertes</contextId>
                            <outputFileName>openapi_interna_dadesobertes</outputFileName>
                            <resourcePackages>
                                <package>es.caib.rfhab.api.interna.config</package>
                                <package>es.caib.rfhab.api.interna.all.exemplereutilitzacio</package>
                            </resourcePackages>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


