  "version": "2.0.0",
  "tasks": [
    {
      "label": "run Create New Terminal command (JBoss RFhab Profile)",
      //   "command": "${command:workbench.action.terminal.newWithProfile}",
      "command": ["${input:runRfhabProfile}"]
    }
  ],
  "inputs": [
    {
      "id": "runRfhabProfile",
      "type": "command",
      "command": "workbench.action.terminal.newWithProfile",
      "args": {
        "profileName": "JBoss RFHab",
        "location": "view"
      }
    }
  ]
}
