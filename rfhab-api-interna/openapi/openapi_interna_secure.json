  "paths" : {
    "/secure/activitat/registre" : {
      "post" : {
        "tags" : [ "RegistreActivitatFuncionariService" ],
        "summary" : "Registra una activiat d'un funcionari",
        "operationId" : "registreActivitat",
        "parameters" : [ {
          "name" : "language",
          "in" : "query",
          "description" : "Idioma en que s'han de retornar les dades(Només suportat 'ca' o 'es')",
          "schema" : {
            "type" : "string",
            "default" : "ca"
          },
          "examples" : {
            "Català" : {
              "description" : "Català",
              "value" : "ca"
            },
            "Castellano" : {
              "description" : "Castellano",
              "value" : "es"
            }
          }
        }, {
          "name" : "funcionari",
          "in" : "query",
          "description" : "NIF del/de la funcionari/ària que realitza la activitat",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "44444444A"
        }, {
          "name" : "tipus",
          "in" : "query",
          "description" : "Tipus de l'activitat:<br />&emsp;<i>1 - Còpia autèntica<br />&emsp;2 - Final tràmit</i>",
          "required" : true,
          "schema" : {
            "type" : "string",
            "description" : "1 - Còpia autèntica<br />&emsp;2 - Final tràmit",
            "enum" : [ "1", "2" ]
          }
        }, {
          "name" : "data",
          "in" : "query",
          "description" : "Data de registre de l'activitat",
          "required" : true,
          "schema" : {
            "pattern" : "^(?:[1-9]\\d{3}-(?:(?:0[1-9]|1[0-2])-(?:0[1-9]|1\\d|2[0-8])|(?:0[13-9]|1[0-2])-(?:29|30)|(?:0[13578]|1[02])-31)|(?:[1-9]\\d(?:0[48]|[2468][048]|[13579][26])|(?:[2468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|[+-][01]\\d:[0-5]\\d)$",
            "type" : "string"
          },
          "example" : "2025-08-31T06:15:00+00:00"
        }, {
          "name" : "identificadorcopiaautentica",
          "in" : "query",
          "description" : "Identificador de còpia autèntica, podria ser un identificador intern de digitalib o bé el csv de la còpia autèntica. Obligatori pel tipus d'activitat 1",
          "schema" : {
            "type" : "string"
          },
          "example" : "klñjjskadfjklsdkl/asdlfjsd"
        }, {
          "name" : "registre",
          "in" : "query",
          "description" : "Número de registre associat a l'activitat. Obligatori pel tipus d'activitat 2",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "idactuaciotramitfh",
          "in" : "query",
          "description" : "Identificador associat a l'activitat de tràmit iniciada que es preten marcar com a finalitzada. Obligatori pel tipus d'activitat 2",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Operació realitzada correctament.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "400" : {
            "description" : "Paràmetres incorrectes",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RestExceptionInfo"
                }
              }
            }
          },
          "401" : {
            "description" : "No Autenticat",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "403" : {
            "description" : "No Autoritzat",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "500" : {
            "description" : "Error no controlat",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RestExceptionInfo"
                }
              }
            }
          }
        },
        "security" : [ {
          "BasicAuth" : [ ]
        } ]
      }
    },
