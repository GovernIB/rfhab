        <!-- comprovació d'apòstrof dins els fitxers properties (solució amb Ant estàndard, que funciona amb Java 11+ i sense dependències externes) -->
        <!-- ALERTA AMB AIXÒ!!! en aquest projecte hi és perquè no vull apòstrofs dins els .properties, però podria no valer o haver-se de canviar per a un altre projecte -->
        <profile>
            <id>apostrophe-check-windows</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
                <file>
                    <exists>scripts/mvnvalidations/check_apostrophe.bat</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.0.0</version>
                        <executions>
                            <execution>
                                <id>check-apostrophe-windows</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target xmlns:unless="ant:unless" xmlns:if="ant:if">
                                        <property name="rfhab.root" value="rfhab-1.0"/>
                                        <condition property="is.rfhab.root">
                                            <contains string="${project.basedir}" substring="${rfhab.root}"/>
                                        </condition>
                                        <echo level="warning" unless:set="is.rfhab.root">========================================</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">AVÍS: Saltant comprovació d'apòstrof</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">Només s'executa dins rfhab-1.0</echo>
                                        <echo level="warning" unless:set="is.rfhab.root">========================================</echo>
                                        <fileset if:set="is.rfhab.root" id="properties.files" dir="${project.basedir}">
                                            <include name="**/src/main/resources/*.properties"/>
                                            <exclude name="**/src/main/resources/ValidationMessages.properties"/>
                                            <exclude name="**/src/main/resources/ValidationMessages_es.properties"/>
                                            <exclude name="**/src/main/resources/genapp_ca.properties"/>
                                            <exclude name="**/src/main/resources/ods-mapping.properties"/>
                                        </fileset>
                                        <apply if:set="is.rfhab.root" executable="cmd" failonerror="true">
                                            <fileset refid="properties.files"/>
                                            <arg value="/c"/>
                                            <arg value="${project.basedir}\scripts\mvnvalidations\check_apostrophe.bat"/>
                                            <srcfile/>
                                        </apply>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>apostrophe-check-unix</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
                <file>
                    <exists>scripts/mvnvalidations/check_apostrophe.bat</exists>
